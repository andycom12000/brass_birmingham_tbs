<Ui>
    <!-- ==================== DEFAULTS ==================== -->
    <Defaults>
        <Button fontSize="14" fontStyle="Bold" textColor="#FFFFFF"/>
    </Defaults>

    <!-- ==================== TURN INDICATOR (top center) ==================== -->
    <Panel id="turnPanel" rectAlignment="UpperCenter" offsetXY="0 -10"
           width="400" height="40" color="#1A1A2EE0" active="true">
        <Text id="turnText" text="" fontSize="16" color="#FFFFFF"
              rectAlignment="MiddleCenter"/>
    </Panel>

    <!-- ==================== END TURN BUTTON (top center, below turn panel) ==================== -->
    <Button id="endTurnBtn" onClick="onEndTurn"
            rectAlignment="UpperCenter" offsetXY="0 -55"
            width="160" height="45" fontSize="18"
            color="#8B2500" textColor="#FFD700" active="true">End Turn</Button>

    <!-- ==================== ACTION BUTTONS (top center, below end turn) ==================== -->
    <Panel id="actionPanel" rectAlignment="UpperCenter" offsetXY="0 -105"
           width="520" height="50" color="#1A1A2EE0" active="true">
        <HorizontalLayout spacing="6" padding="0 0 0 0"
                          rectAlignment="MiddleCenter">
            <Button id="sellBtn" onClick="onSellBtn"
                    preferredWidth="90" preferredHeight="40"
                    color="#4A7C59" textColor="#FFFFFF" fontSize="14">Sell</Button>
            <Button id="develop1Btn" onClick="onDevelop1Btn"
                    preferredWidth="105" preferredHeight="40"
                    color="#5B6A8A" textColor="#FFFFFF" fontSize="13">Develop 1</Button>
            <Button id="develop2Btn" onClick="onDevelop2Btn"
                    preferredWidth="105" preferredHeight="40"
                    color="#5B6A8A" textColor="#FFFFFF" fontSize="13">Develop 2</Button>
            <Button id="loanBtn" onClick="onLoanBtn"
                    preferredWidth="90" preferredHeight="40"
                    color="#8B6914" textColor="#FFFFFF" fontSize="14">Loan</Button>
            <Button id="scoutBtn" onClick="onScoutBtn"
                    preferredWidth="90" preferredHeight="40"
                    color="#6B4C8A" textColor="#FFFFFF" fontSize="14">Scout</Button>
        </HorizontalLayout>
    </Panel>

    <!-- ==================== SINGLE LINK BUTTON (double rail flow) ==================== -->
    <Button id="singleLinkBtn" onClick="onSingleLinkOnly"
            rectAlignment="UpperCenter" offsetXY="0 -155"
            width="200" height="40" fontSize="14"
            color="#2E5090" textColor="#FFFFFF" active="true">Single Link Only</Button>

    <!-- ==================== ACCEPT VP LOSS BUTTON (income shortfall) ==================== -->
    <Button id="acceptVPLossBtn" onClick="onAcceptVPLossBtn"
            rectAlignment="UpperCenter" offsetXY="0 -155"
            width="220" height="40" fontSize="14"
            color="#8B2500" textColor="#FFFFFF" active="true">Accept VP Loss</Button>

    <!-- ==================== LANGUAGE TOGGLE (bottom left) ==================== -->
    <Button id="langToggle" onClick="toggleLanguage"
            rectAlignment="LowerLeft" offsetXY="15 15"
            width="80" height="28" fontSize="11"
            color="#8B7355" textColor="#D4C5A0">EN / ZH</Button>
</Ui>
